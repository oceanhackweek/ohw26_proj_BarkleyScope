.ipynb_checkpoints
__pycache__/
*.pyc
__marimo__/

# Large/local data used by final_notebooks/Glider_Curtain_Plot.ipynb -- keep a local copy
# alongside the notebook, but per the note in the Datasets section, don't commit it.
Barkley_Sound_Bathymetry.nc
NE_San_Diego_Trough_Aug_2022.csv

# The delayed-mode archive is ~37 MB and fully reproducible from ERDDAP in a couple
# of minutes, so it is rebuilt locally rather than carried in the repo:
#     python data/update_cproof_glider.py --mode delayed
# The real-time archive IS tracked -- it is small, and the scheduled job commits it.
data/cproof_glider_delayed.nc

# Superseded by the netCDF archives.
data/cproof_barkley_gliders.csv

# Real-time files pulled straight from the C-PROOF server by data/cproof_https.py.
# Not tracked: they are rewritten hourly upstream (so a committed copy is stale by
# definition), and the gridded ones are 17-60 MB each. Re-fetch with:
#     python data/cproof_https.py
data/cproof/

# Carries a live ONC API token in a code cell. Keep a local copy to work from, but it
# must not enter the history -- a token committed once stays in the history even after
# it is edited out. If you need to share this notebook, read the token from an
# environment variable first:
#     token = os.environ["ONC_TOKEN"]
data/PartII_API_Access.ipynb

# Rebuilt from the archive in seconds by `python data/sst/export_layer.py`, and
# regenerated after every fetch -- committing it would add ~2 MB to the history each
# time. It is the file handed to the shared app, but it is a build artifact, not a
# source. See data/sst/README.md, "export_layer.py -- the handoff".
data/sst_barkley_layer.geojson
