.ipynb_checkpoints
__pycache__/
*.pyc
__marimo__/

# Large/local data used by final_notebooks/Glider_Curtain_Plot.ipynb -- keep a local copy
# alongside the notebook, but per the note in the Datasets section, don't commit it.
Barkley_Sound_Bathymetry.nc
NE_San_Diego_Trough_Aug_2022.csv

# The delayed-mode archive is ~37 MB and fully reproducible from ERDDAP in a couple
# of minutes, so it is rebuilt locally rather than carried in the repo:
#     python data/update_cproof_glider.py --mode delayed
# The real-time archive IS tracked -- it is small, and the scheduled job commits it.
data/cproof_glider_delayed.nc

# Superseded by the netCDF archives.
data/cproof_barkley_gliders.csv

# Real-time files pulled straight from the C-PROOF server by data/cproof_https.py.
# Not tracked: they are rewritten hourly upstream (so a committed copy is stale by
# definition), and the gridded ones are 17-60 MB each. Re-fetch with:
#     python data/cproof_https.py
data/cproof/

# Carries a live ONC API token in a code cell. Keep a local copy to work from, but it
# must not enter the history -- a token committed once stays in the history even after
# it is edited out. If you need to share this notebook, read the token from an
# environment variable first:
#     token = os.environ["ONC_TOKEN"]
data/PartII_API_Access.ipynb

# NFS "silly rename" artifacts. Home directories on the hub are NFS, where deleting or
# replacing a file that another process still has open leaves a .nfs* stand-in behind
# until that process closes it. They appear as untracked files and are not ours to keep --
# e.g. replacing data/sst_barkley_realtime.nc while a marimo kernel is reading it.
.nfs*

# Glider gridded files from C-PROOF, fetched by data/fetch_grid_adjusted.py.
# 26 files, 10.68 GB -- 21 of them are individually over GitHub's 100 MB per-file
# limit, so these cannot be committed at all. They live on the release instead:
#     https://github.com/oceanhackweek/ohw26_proj_BarkleyScope/releases/tag/glider-adjusted-v1
# Rebuild from the server with `python data/fetch_grid_adjusted.py`, or pull the
# mirrored copies with `gh release download glider-adjusted-v1`.
# manifest.json is deliberately NOT ignored -- it is small, and it is the record of
# what the set contains and why each excluded mission was excluded.
data/glider_adjusted/**/*.nc
data/glider_adjusted/rejected/

# Local scratch notes. HANDOFF.md is orientation for whoever picks the branch up next --
# useful while the work is in flight, stale the moment it merges, and it duplicates what
# the tracked docs (data/README.md, final_notebooks/MARIMO_APP_STATUS.md) already say
# properly. Keep your own; don't commit it.
final_notebooks/HANDOFF.md

# Preview renders. build_historical_tracks.py and the sst/preview_*.py scripts draw these
# to eyeball a layer before trusting it; they are checks, not outputs, and they are
# regenerated in seconds from committed data.
data/glider_tracks_map.png
data/sst/preview_*.png
